NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：提高 GitHub API 额度，用于项目卡片拉取仓库标题/简介/封面元数据（公开仓库无 token 也可用，约 60 次/小时/IP）
# GITHUB_TOKEN=

# 站长控制台 /admin（MVP：密码 + HttpOnly Cookie，不含密钥管理）
# SITE_OWNER_CONSOLE_SECRET=请使用 openssl rand -hex 32 等生成随机串
# SITE_OWNER_CONSOLE_PASSWORD=仅本人知晓的强密码
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# 推荐：内容抓取脚本（ingest）遇到 403 时，经 https://r.jina.ai/ 读取正文（URL 会发往第三方）
INGEST_JINA_ON_403=1
# 可选：与本机 Chrome「复制 User-Agent」一致，部分站点校验更严
# INGEST_USER_AGENT=
